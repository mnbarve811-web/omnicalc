  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Cobalt action; used sparingly.",
      "html": "<button class=\"ds-btn-primary\">See breakdown <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14\"/><path d=\"m19 12-7 7-7-7\"/></svg></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:6px;height:44px;padding:0 14px;border:1px solid transparent;border-radius:6px;background:var(--primary,#2747c9);color:var(--primary-foreground,#fff);font:500 14px/1 Geist,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background .15s}.ds-btn-primary:hover{background:color-mix(in srgb,var(--primary,#2747c9) 80%,transparent)}.ds-btn-primary:focus-visible{outline:none;border-color:var(--ring,#2747c9);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#2747c9) 50%,transparent)}.ds-btn-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Copy link, PDF, CSV.",
      "html": "<button class=\"ds-btn-outline\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 17H7A5 5 0 0 1 7 7h2\"/><path d=\"M15 7h2a5 5 0 1 1 0 10h-2\"/><line x1=\"8\" x2=\"16\" y1=\"12\" y2=\"12\"/></svg>Copy link</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 12px;border:1px solid var(--border,#d5dbe3);border-radius:6px;background:var(--card,#fff);color:var(--foreground,#141b2d);font:500 14px/1 Geist,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background .15s}.ds-btn-outline:hover{background:var(--muted,#e3e8ef)}.ds-btn-outline:focus-visible{outline:none;border-color:var(--ring,#2747c9);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#2747c9) 50%,transparent)}.ds-btn-outline:active{transform:translateY(1px)}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Reset and other low-emphasis actions.",
      "html": "<button class=\"ds-btn-ghost\">Reset</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 12px;border:1px solid transparent;border-radius:6px;background:transparent;color:var(--foreground,#141b2d);font:500 14px/1 Geist,ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-btn-ghost:hover{background:var(--muted,#e3e8ef)}.ds-btn-ghost:focus-visible{outline:none;border-color:var(--ring,#2747c9);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#2747c9) 50%,transparent)}.ds-btn-ghost:disabled{opacity:.5;pointer-events:none}"
    },
    {
      "name": "Labelled Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Calculator input with visible label and inline prefix.",
      "html": "<div class=\"ds-field\"><label class=\"ds-field-label\" for=\"ds-price\">Home Price</label><div class=\"ds-field-wrap\"><span class=\"ds-field-prefix\">$</span><input id=\"ds-price\" class=\"ds-field-input\" type=\"number\" value=\"400000\"></div></div>",
      "css": ".ds-field{width:320px;font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-field-label{display:block;margin-bottom:6px;font-size:14px;font-weight:500;color:var(--foreground,#141b2d)}.ds-field-wrap{position:relative}.ds-field-prefix{position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:14px;color:var(--muted-foreground,#4a5568);pointer-events:none}.ds-field-input{width:100%;height:44px;padding:4px 12px 4px 28px;border:1px solid var(--input,#8b95a7);border-radius:6px;background:var(--card,#fff);color:var(--foreground,#141b2d);font:400 16px Geist,ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;caret-color:var(--primary,#2747c9);outline:none;transition:border-color .15s}.ds-field-input:focus-visible{border-color:var(--ring,#2747c9);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#2747c9) 50%,transparent)}"
    },
    {
      "name": "Header Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Sticky white header with pillar-dot category links.",
      "html": "<header class=\"ds-header\"><a class=\"ds-header-mark\" href=\"#\">OmniCalc</a><nav class=\"ds-header-nav\"><a class=\"ds-nav-link\" aria-current=\"page\" href=\"#\"><span class=\"ds-dot\" style=\"background:var(--pillar-financial,#0f8a6a)\"></span>Financial</a><a class=\"ds-nav-link\" href=\"#\"><span class=\"ds-dot\" style=\"background:var(--pillar-fitness,#d23d5e)\"></span>Fitness</a><a class=\"ds-nav-link\" href=\"#\"><span class=\"ds-dot\" style=\"background:var(--pillar-math,#4f46e5)\"></span>Math</a><a class=\"ds-nav-link\" href=\"#\"><span class=\"ds-dot\" style=\"background:var(--pillar-utility,#b86e0a)\"></span>Utility</a></nav></header>",
      "css": ".ds-header{display:flex;align-items:center;gap:24px;height:56px;padding:0 24px;background:var(--card,#fff);border-bottom:1px solid var(--border,#d5dbe3);font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-header-mark{font-size:18px;font-weight:600;letter-spacing:-0.02em;color:var(--foreground,#141b2d);text-decoration:none}.ds-header-nav{display:flex;gap:4px}.ds-nav-link{display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;font-size:14px;font-weight:500;color:var(--muted-foreground,#4a5568);text-decoration:none;transition:background .15s,color .15s}.ds-nav-link:hover{background:var(--muted,#e3e8ef);color:var(--foreground,#141b2d)}.ds-nav-link[aria-current=page]{color:var(--foreground,#141b2d)}.ds-nav-link:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#2747c9) 50%,transparent)}.ds-dot{width:6px;height:6px;border-radius:9999px;flex-shrink:0}"
    },
    {
      "name": "Pillar Chip",
      "kind": "chip",
      "refersTo": "chip-link",
      "description": "Popular calculators and other-category links.",
      "html": "<a class=\"ds-chip\" href=\"#\"><span class=\"ds-dot\" style=\"background:var(--pillar-financial,#0f8a6a)\"></span>Mortgage</a>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border:1px solid var(--border,#d5dbe3);border-radius:9999px;background:var(--card,#fff);color:var(--foreground,#141b2d);font:400 14px Geist,ui-sans-serif,system-ui,sans-serif;text-decoration:none;transition:border-color .15s,color .15s}.ds-chip:hover{border-color:color-mix(in srgb,var(--primary,#2747c9) 40%,transparent);color:var(--primary,#2747c9)}.ds-chip:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#2747c9) 50%,transparent)}.ds-dot{width:6px;height:6px;border-radius:9999px;flex-shrink:0}"
    },
    {
      "name": "Work Panel",
      "kind": "card",
      "refersTo": "card-panel",
      "description": "White panel on the tinted ground for inputs, charts and tables.",
      "html": "<div class=\"ds-card\"><h2 class=\"ds-card-title\">Loan Details</h2><p class=\"ds-card-body\">One soft resting shadow and a hairline border.</p></div>",
      "css": ".ds-card{width:320px;padding:20px;border:1px solid var(--border,#d5dbe3);border-radius:10px;background:var(--card,#fff);color:var(--foreground,#141b2d);box-shadow:0 1px 2px rgba(20,27,45,0.04), 0 8px 24px -18px rgba(20,27,45,0.22);font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-card-title{margin:0 0 8px;font-size:16px;font-weight:600;letter-spacing:-0.01em}.ds-card-body{margin:0;font-size:14px;color:var(--muted-foreground,#4a5568)}"
    },
    {
      "name": "Result Hero with Proportion Bar",
      "kind": "custom",
      "refersTo": "result-hero",
      "description": "Signature: the answer, its caption, and what it is made of.",
      "html": "<section class=\"ds-hero\"><p class=\"ds-hero-label\">Total Monthly</p><p class=\"ds-hero-value\">$2,549</p><p class=\"ds-hero-caption\">Estimated monthly housing cost</p><div class=\"ds-bar\"><span style=\"flex-grow:2129;background:var(--chart-1,#2747c9)\"></span><span style=\"flex-grow:300;background:var(--chart-2,#b86e0a)\"></span><span style=\"flex-grow:120;background:var(--chart-4,#6b7a99)\"></span></div><ul class=\"ds-legend\"><li><i style=\"background:var(--chart-1,#2747c9)\"></i><span>Principal &amp; interest</span><b>$2,129</b><em>84%</em></li><li><i style=\"background:var(--chart-2,#b86e0a)\"></i><span>Property tax</span><b>$300</b><em>12%</em></li><li><i style=\"background:var(--chart-4,#6b7a99)\"></i><span>Insurance</span><b>$120</b><em>5%</em></li></ul></section>",
      "css": ".ds-hero{width:480px;padding:24px;border:1px solid var(--border,#d5dbe3);border-radius:10px;background:var(--card,#fff);box-shadow:0 1px 2px rgba(20,27,45,0.04), 0 8px 24px -18px rgba(20,27,45,0.22);font-family:Geist,ui-sans-serif,system-ui,sans-serif;color:var(--foreground,#141b2d)}.ds-hero-label{margin:0;font-size:14px;font-weight:500;color:var(--muted-foreground,#4a5568)}.ds-hero-value{margin:4px 0 0;font-size:60px;font-weight:600;line-height:1;letter-spacing:-0.035em;font-variant-numeric:tabular-nums}.ds-hero-caption{margin:8px 0 20px;font-size:14px;color:var(--muted-foreground,#4a5568)}.ds-bar{display:flex;gap:2px;height:12px;overflow:hidden;border-radius:9999px;background:var(--muted,#e3e8ef)}.ds-bar span{flex-basis:0;height:100%;transition:flex-grow .3s ease-out}.ds-legend{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:6px;font-size:14px}.ds-legend li{display:flex;align-items:center;gap:8px}.ds-legend i{width:10px;height:10px;border-radius:3px}.ds-legend span{color:var(--muted-foreground,#4a5568)}.ds-legend b{margin-left:auto;font-weight:500;font-variant-numeric:tabular-nums}.ds-legend em{width:40px;text-align:right;font-style:normal;font-size:12px;color:var(--muted-foreground,#4a5568);font-variant-numeric:tabular-nums}"
    }
  ],
  "narrative": {
    "northStar": "The Calibrated Instrument",
    "overview": "OmniCalc reads like a well-made measuring tool: a cool, blue-tinted ground under white work panels, blue-black ink, and a single cobalt that means \"you can act here\" or \"this is the primary series\". Nothing is decorative. Every surface exists to take numbers in, show the answer, or show what the answer is made of. The answer is the largest thing on a calculator page; the inputs sit beside it in a narrow sticky column, and the explanation follows in a plain reading column below.\n\nDensity is moderate and even. Panels are flat white with one quiet resting shadow; lists are divided by hairline rules rather than boxed; category is carried by small coloured dots, never by fills. Motion is almost absent: a 200ms flash when a result changes, and one bar-growth moment on the homepage example. Both disappear under reduced motion.\n\nThe world rejects the generic calculator kit: four equal stat tiles, an export toolbar above the result, oversized wordmarks, serif accent words, eyebrows, glows, numbered section headings and decorative marquees.",
    "keyCharacteristics": [
      "Blue-tinted ground, white panels, blue-black ink, one cobalt.",
      "Geist throughout, tabular figures for every number.",
      "Answer-first hierarchy: the result figure outranks the page title.",
      "A stacked proportion bar under the answer whenever the result genuinely decomposes.",
      "Category marked by pillar dots only.",
      "Hairline-divided lists instead of card grids."
    ],
    "rules": [
      {
        "name": "The One Cobalt Rule",
        "body": "Cobalt is interaction, focus and the primary series. It is never a background wash, a heading colour or a decorative accent.",
        "section": "colors"
      },
      {
        "name": "The Counter-Series Rule",
        "body": "Amber means cost. A value that is money going out (interest, tax) takes the amber series and swatch; nothing else does.",
        "section": "colors"
      },
      {
        "name": "The Wayfinding Dot Rule",
        "body": "Pillar hues appear only as small round dots (6px in nav and lists, 8px in directory headings and search results, 12px beside a hub title). Never as fills, text colour, borders or data series.",
        "section": "colors"
      },
      {
        "name": "The Opaque Tint Rule",
        "body": "Chart fills use the opaque `-tint` tokens. Translucent series drift to lavender and tan over white.",
        "section": "colors"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Every number a visitor reads as a quantity (inputs, results, stats, tables, legend values) is set with tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Answer-First Rule",
        "body": "On a calculator page the result figure is larger than the H1. Nothing on the page competes with it in size or weight.",
        "section": "typography"
      },
      {
        "name": "The One Resting Shadow Rule",
        "body": "A surface at rest gets the panel shadow or nothing. Stronger shadows are reserved for elements that float above the page (popover, fixed bar). No glows, no coloured shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do make the result figure the largest element on a calculator page (2.75rem to 3.75rem, 600, tabular).",
      "Do set every quantity in tabular figures.",
      "Do reserve cobalt for interaction, focus and the primary series; use amber only for costs.",
      "Do use opaque `-tint` tokens for chart fills, with full-strength strokes.",
      "Do mark category with pillar dots only.",
      "Do keep touch targets at 44px below md, give every input a visible label, and keep focus rings visible (3px cobalt at 50%).",
      "Do wrap every authored motion in a reduced-motion guard so values and bars render final without it.",
      "Do divide lists with hairlines rather than putting each item in a card."
    ],
    "donts": [
      "Don't use four equal stat tiles or put an export toolbar above the result.",
      "Don't place ads between inputs and results.",
      "Don't add eyebrows or kickers above headings, glows, or coloured shadows.",
      "Don't number sections or category groups; numbering is for genuine ordered steps only.",
      "Don't use raw Tailwind palette hues (blue-400, green-100 and so on); every colour comes from a token.",
      "Don't use pillar hues as fills, text or data series.",
      "Don't add a second typeface or a serif accent.",
      "Don't add load or scroll animation beyond the homepage example bars and the result flash."
    ]
